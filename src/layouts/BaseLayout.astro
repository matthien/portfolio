---
import '../styles/tokens.css';
import '../styles/global.css';
import { site } from '../lib/site';
import Bio from '../components/Bio.astro';import MobileMenu from '../components/MobileMenu.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** Show the bio under the name on mobile (the Work page). */
  showMobileBio?: boolean;
  /** On mobile, start the page content 32px below the name instead of 48px (the About page). */
  compactMobileTop?: boolean;
  /** Let the page content run edge to edge, with no padding around it (the Thoughtscape page). */
  fullBleed?: boolean;
  /** "mat" switches the whole page to Thoughtscape's dark mat colors (see tokens.css). */
  theme?: 'light' | 'mat';
}

const {
  title,
  description = site.description,
  showMobileBio = false,
  compactMobileTop = false,
  fullBleed = false,
  theme = 'light',
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : site.name;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="en" data-theme={theme === 'mat' ? 'mat' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content={theme === 'mat' ? '#19191b' : '#ffffff'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Geist+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <div class="shell">
      <Sidebar pathname={pathname} />

      <header class="mobile-header" data-menu-inert>
        <p class="t-mobile-header"><a class="home-link" href="/">{site.name}</a></p>
        {
          showMobileBio && (
            <div class="mobile-bio">
              <Bio />
            </div>
          )
        }
      </header>

      <MobileMenu pathname={pathname} />

      <main
        class:list={['main', { compact: compactMobileTop, bleed: fullBleed }]}
        data-menu-inert
      >
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .shell {
    display: flex;
    min-height: 100vh;
  }

  .main {
    flex: 1;
    min-width: 0;
    padding: var(--space-6) var(--space-4);
  }

  .main.bleed {
    padding: 0;
  }

  .mobile-header {
    display: none;
  }

  @media (width < 900px) {
    .shell {
      display: block;
      padding: var(--space-4) var(--space-3);
    }

    .mobile-header {
      display: block;
      /* Keep the name clear of the fixed menu button */
      padding-right: var(--tap);
    }

    .mobile-bio {
      margin-top: var(--space-2);
    }

    .main {
      margin-top: var(--space-7);
      padding: 0;
    }

    .main.compact {
      margin-top: var(--space-5);
    }

    /* Cancel the page's side and bottom padding so the content reaches the screen edges */
    .main.bleed {
      margin-inline: calc(-1 * var(--space-3));
      margin-bottom: calc(-1 * var(--space-4));
    }
  }
</style>
