---
import { nav, isActive } from '../lib/site';

interface Props {
  pathname: string;
  variant: 'sidebar' | 'menu';
}

const { pathname, variant } = Astro.props;
---

<nav aria-label="Main">
  <ul class:list={['nav', variant]} role="list">
    {
      nav.map((item) => {
        const active = isActive(item.href, pathname);
        return (
          <li>
            <a
              class:list={['nav-link', 't-link', { active }]}
              href={item.href}
              aria-current={active ? 'page' : undefined}
              data-menu-link={variant === 'menu' ? '' : undefined}
            >
              <span class="dash-wrap" aria-hidden="true">
                <span class="dash">–</span>
              </span>
              {item.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .nav {
    display: flex;
    flex-direction: column;
  }

  .sidebar {
    gap: var(--space-1);
  }

  .menu {
    gap: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    color: var(--muted);
    transition: color var(--dur-hover) var(--ease);
  }

  /*
   * The dash sits in a column that is 0 wide at rest. On the active link, and on hover,
   * the column opens to the dash's width and pushes the label to the right.
   */
  .dash-wrap {
    display: grid;
    grid-template-columns: 0fr;
    overflow: hidden;
    transition: grid-template-columns var(--dur-dash) var(--ease-out);
  }

  .dash {
    min-width: 0;
    padding-right: var(--space-2);
    white-space: nowrap;
    opacity: 0;
    transition: opacity var(--dur-dash-fade) var(--ease-out);
  }

  .nav-link.active .dash-wrap,
  .nav-link:focus-visible .dash-wrap {
    grid-template-columns: 1fr;
  }

  .nav-link.active .dash,
  .nav-link:focus-visible .dash {
    opacity: 1;
  }

  @media (hover: hover) {
    .nav-link:hover .dash-wrap {
      grid-template-columns: 1fr;
    }

    .nav-link:hover .dash {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .dash-wrap,
    .dash {
      transition: none;
    }
  }

  .sidebar .nav-link {
    height: var(--nav-row);
  }

  .menu .nav-link {
    height: var(--nav-row-mobile);
    font-size: var(--size-mobile-link);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--ink);
  }
</style>
