---
import { site } from '../lib/site';
import Bio from './Bio.astro';import ContactLinks from './ContactLinks.astro';
import NavLinks from './NavLinks.astro';

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
---

<aside class="sidebar">
  <p class="t-name"><a class="home-link" href="/">{site.name}</a></p>
  <div class="bio-wrap">
    <Bio />
  </div>
  <div class="nav-wrap">
    <NavLinks pathname={pathname} variant="sidebar" />
  </div>
  <div class="contact-wrap">
    <ContactLinks variant="sidebar" />
  </div>
  <p class="footer t-mono muted">{site.footer}</p>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    align-self: flex-start;
    flex: none;
    display: flex;
    flex-direction: column;
    width: var(--sidebar-width);
    height: 100vh;
    padding: var(--space-6) var(--space-4);
    /* On a short window, scroll instead of letting the link groups collide */
    overflow-y: auto;
  }

  .bio-wrap {
    margin-top: var(--space-2);
  }

  .nav-wrap {
    margin-top: var(--space-5);
    /* Minimum space between the two link groups when the window is short */
    margin-bottom: var(--space-5);
  }

  /* Pushes the contact links and copyright to the bottom */
  .contact-wrap {
    margin-top: auto;
  }

  .footer {
    margin-top: var(--space-5);
  }

  @media (width < 900px) {
    .sidebar {
      display: none;
    }
  }
</style>
