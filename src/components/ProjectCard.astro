---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Pill from './Pill.astro';

interface Props {
  href: string;
  title: string;
  tag: string;
  cover?: ImageMetadata;
}

const { href, title, tag, cover } = Astro.props;
---

<a class="card" href={href}>
  <div class="media">
    {
      cover && (
        <Image
          src={cover}
          alt=""
          widths={[480, 720, 960, 1440]}
          sizes="(width >= 900px) calc((100vw - 348px - 48px) / 2), calc(100vw - 32px)"
        />
      )
    }
  </div>
  <div class="caption">
    <h2 class="t-title title">{title}</h2>
    <Pill>{tag}</Pill>
  </div>
</a>

<style>
  .card {
    display: block;
    color: var(--ink);
  }

  .media {
    transition:
      filter var(--dur-hover) var(--ease),
      transform var(--dur-hover) var(--ease);
  }

  .card:hover .media {
    filter: brightness(var(--hover-dim));
    transform: translateY(var(--hover-lift));
  }

  .caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  @media (width < 900px) {
    .caption {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: var(--space-2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .media {
      transition: filter var(--dur-hover) var(--ease);
    }

    .card:hover .media {
      transform: none;
    }
  }
</style>
