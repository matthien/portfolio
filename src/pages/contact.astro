---
import BaseLayout from '../layouts/BaseLayout.astro';

// Replace the bracketed values. When they are real, wrap each in a link
// (mailto:, the LinkedIn URL, the resume file).
const rows = [
  { label: 'Email', value: '[Your email]' },
  { label: 'LinkedIn', value: '[LinkedIn URL]' },
  { label: 'Resume', value: '[Resume link]' },
];
---

<BaseLayout title="Contact" description="Get in touch with Matt Thien.">
  <section class="page">
    <h1 class="t-title">Contact</h1>
    <dl class="rows">
      {
        rows.map((row) => (
          <div class="row">
            <dt class="t-mono muted">{row.label}</dt>
            <dd class="t-body">{row.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</BaseLayout>

<style>
  .rows {
    max-width: var(--prose-max);
    border-bottom: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: var(--label-col) minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--line);
  }
</style>
